NODE_ENV=production
PORT=5002
HOST=0.0.0.0
TRUST_PROXY=1

DATABASE_URL=postgresql://easyfuel_app:password@postgres:5432/easyfuel

AUTH_PROVIDER=local
SESSION_SECRET=change_me_strong_session_secret
JWT_ACCESS_SECRET=change_me_strong_jwt_access_secret
JWT_REFRESH_SECRET=change_me_strong_jwt_refresh_secret

OBJECT_STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=/app/storage
PRIVATE_OBJECT_DIR=private

PUBLIC_APP_URL=https://portal.easyfuel.ai
SUBSCRIPTION_TEST_MODE=false

OZOW_IS_TEST=false
OZOW_SITE_CODE=your-site-code
OZOW_CLIENT_ID=your-client-id
OZOW_CLIENT_SECRET=your-client-secret
OZOW_PRIVATE_KEY=your-merchant-private-key
OZOW_ONE_API_BASE_URL=https://one.ozow.com
OZOW_PAYOUT_API_KEY=your-payout-api-key
OZOW_PAYOUT_ACCESS_TOKEN=your-24-char-token

RESEND_API_KEY=
RESEND_FROM_EMAIL=Easy Fuel ZA <noreply@easyfuel.ai>
CONTACT_TO_EMAIL=notification@easyfuel.ai

VITE_MAPBOX_TOKEN=your-mapbox-token

VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
